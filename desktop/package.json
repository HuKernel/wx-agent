{
  "name": "emora-desktop",
  "version": "0.1.0",
  "description": "Emora AI desktop client",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build:backend": "cd ../backend && .venv/Scripts/python -m PyInstaller --noconfirm --clean --onedir --name emora-backend --collect-submodules uvicorn run.py",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "ai.emora.desktop",
    "productName": "Emora AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/emora-backend",
        "to": "sidecar/emora-backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
